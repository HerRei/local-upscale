          "model_id": "nafnet_gopro_deblur",
          "model_path": "/models/nafnet.pth"
        },
        {
          "kind": "deblock",
          "role": "fix",
          "fix": "jpeg",
          "model_id": "fbcnn_color",
          "model_path": "/models/fbcnn.pth"
        },
        {
          "kind": "upscale",
          "role": "primary",
          "model_id": "span_photo_x4",
          "model_path": "/models/span.safetensors"
        },
        {
          "kind": "face_restore",
          "model_id": "hat_l_x4_face",
