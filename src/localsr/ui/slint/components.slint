import { ScrollView } from "std-widgets.slint";

// "Machined Graphite" — LocalSR's bespoke control set. Brightness encodes
// proximity: content sinks, chrome rises. Fields recess, buttons rise, and
// only the floating layer (HUD, chips, popups, thumbs) casts shadows. The
// palette and metrics live in the Theme global so both files speak one
// language. Controls keep the platform's default typeface.

export global Theme {
    // Planes.
    out property <color> bg-stage: #0C0D10;
    out property <color> bg-base: #14171B;
    out property <color> bg-panel: #1B1D22;
    out property <color> bg-chrome: #21242A;
    out property <color> bg-raised: #282B32;
    out property <color> bg-hover: #2E333B;
    out property <color> bg-pressed: #24282E;
    out property <color> bg-recess: #16181C;
    out property <color> bg-disabled: #232427;
    out property <color> bg-overlay: #16181CEB;
    out property <color> bg-row-hover: #FFFFFF07;

    // Text tiers.
    out property <color> text-primary: #F0F1F4;
    out property <color> text-secondary: #9DA1A8;
    out property <color> text-tertiary: #7A8089;
    out property <color> text-disabled: #575C64;
    out property <color> text-on-accent-secondary: #DCE9FF;
    out property <color> text-accent: #9DC0FD;

    // Seams and borders.
    out property <color> sep-shadow: #08090B;
    out property <color> sep-light: #FFFFFF09;
    out property <color> sep-inset: #FFFFFF09;
    out property <color> border-control: #FFFFFF12;
    out property <color> border-control-hover: #FFFFFF1C;
    out property <color> border-recess: #FFFFFF0F;
    out property <color> focus: #4E8CFF;
    out property <color> focus-glow: #4E8CFF40;

    // Accent material.
    out property <color> accent: #4E8CFF;
    out property <color> accent-hover: #6A9EFE;
    out property <color> accent-pressed: #407BE9;
    out property <brush> accent-gradient: @linear-gradient(180deg, #447EEA 0%, #346DD7 100%);
    out property <brush> accent-gradient-hover: @linear-gradient(180deg, #4583F5 0%, #3571E2 100%);
    out property <brush> accent-gradient-pressed: @linear-gradient(180deg, #3A6FD4 0%, #2A5EC1 100%);
    out property <color> accent-tint12: #4E8CFF1F;
    out property <color> accent-tint18: #4E8CFF2E;
    out property <color> accent-border-sel: #4E8CFF80;

    // Semantic.
    out property <color> warn: #DE9935;
    out property <color> warn-text: #E7BC72;
    out property <color> warn-bg: #2A2011;
    out property <color> warn-border: #DE993533;
    out property <color> error: #E5484D;
    out property <color> error-text: #FFACAE;
    out property <color> error-bg: #2F1C1C;
    out property <color> error-border: #E5484D4D;
    out property <color> gauge-ok: #6DB07F;
    out property <color> gauge-warn: #DE9935;
    out property <color> gauge-crit: #E5484D;
}

// Slint 1.9's stock ComboBox consumes wheel events even when it is closed.
// That changes settings while the user only intends to scroll the inspector,
// so this control rejects closed wheel events and lets its parent scroll.
export component DesktopComboBox inherits Rectangle {
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current-index: 0;
    out property <string> current-value:
        root.current-index >= 0 && root.current-index < root.model.length ?
            root.model[root.current-index] : "";
    callback selected(string);

    height: 30px;
    min-width: 128px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-width: 1px;
    border-color: !root.enabled ? #FFFFFF0A : control-focus.has-focus ? Theme.focus :
        control-touch.has-hover ? #FFFFFF17 : Theme.border-recess;
    border-radius: 6px;
    background: !root.enabled ? Theme.bg-disabled : control-touch.pressed ? #13161A :
        control-touch.has-hover ? #191B20 : Theme.bg-recess;
    drop-shadow-blur: control-focus.has-focus ? 4px : 0px;
    drop-shadow-color: Theme.focus-glow;
    clip: true;
    forward-focus: control-focus;
    animate border-color, background { duration: 120ms; easing: ease; }

    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-label: root.current-value;
    accessible-value: root.current-value;
    accessible-action-default => {
        if (root.enabled) {
            popup.show();
        }
    }

    Text {
        x: 11px;
        width: parent.width - 40px;
        text: root.current-value;
        color: root.enabled ? Theme.text-primary : Theme.text-disabled;
        font-size: 13px;
        overflow: elide;
        vertical-alignment: center;
    }

    // The caret glyph's ink sits low in its em box; a 2px lift puts it on
    // the control's optical centerline.
    Text {
        x: parent.width - 26px;
        y: (parent.height - 16px) / 2 - 2px;
        width: 16px;
        height: 16px;
        text: "⌄";
        color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    control-focus := FocusScope {
        key-pressed(event) => {
            if (!root.enabled) {
                return reject;
            }
            if (event.text == Key.UpArrow) {
                root.choose(max(0, root.current-index - 1));
                return accept;
            } else if (event.text == Key.DownArrow) {
                root.choose(min(root.model.length - 1, root.current-index + 1));
                return accept;
            } else if (event.text == Key.Return) {
                popup.show();
                return accept;
            }
            return reject;
        }

        control-touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                control-focus.focus();
                popup.show();
            }
            scroll-event(event) => {
                // Never cycle a closed settings combo with the wheel/trackpad.
                return reject;
            }
        }
    }

    function choose(index: int) {
        if (!root.enabled || index < 0 || index >= root.model.length) {
            return;
        }
        root.current-index = index;
        root.selected(root.current-value);
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: max(1, min(5, root.model.length)) * 30px + 10px;
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;

        popup-focus := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.UpArrow) {
                    root.choose(max(0, root.current-index - 1));
                    return accept;
                } else if (event.text == Key.DownArrow) {
                    root.choose(min(root.model.length - 1, root.current-index + 1));
                    return accept;
                } else if (event.text == Key.Return || event.text == Key.Escape) {
                    popup.close();
                    return accept;
                }
                return reject;
            }

            Rectangle {
                background: Theme.bg-raised;
                border-width: 1px;
                border-color: #FFFFFF15;
                border-radius: 8px;
                drop-shadow-blur: 24px;
                drop-shadow-color: #000000A6;
                drop-shadow-offset-y: 8px;

                ScrollView {
                    x: 5px;
                    y: 5px;
                    width: parent.width - 10px;
                    height: parent.height - 10px;
                    viewport-width: self.width;

                    VerticalLayout {
                        width: parent.width;
                        spacing: 0px;

                        for value[index] in root.model: Rectangle {
                            height: 30px;
                            width: parent.width;
                            border-radius: 5px;
                            background: option-touch.pressed ? Theme.accent-pressed :
                                index == root.current-index ? Theme.accent-gradient :
                                option-touch.has-hover ? #FFFFFF0F : transparent;

                            Text {
                                x: 10px;
                                width: parent.width - 20px;
                                text: value;
                                color: index == root.current-index ? white : Theme.text-primary;
                                font-size: 13px;
                                font-weight: index == root.current-index ? 500 : 400;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            option-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.choose(index);
                                    popup.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// The thin axis is pinned to 1px via min/max so the long axis stays free
// for the parent layout to stretch — an explicit width would override it.
export component ThinSeparator inherits Rectangle {
    in property <bool> vertical: false;
    background: root.vertical ? Theme.sep-shadow : Theme.sep-inset;
    min-width: root.vertical ? 1px : 0px;
    max-width: root.vertical ? 1px : 100000px;
    min-height: root.vertical ? 0px : 1px;
    max-height: root.vertical ? 100000px : 1px;
    horizontal-stretch: root.vertical ? 0 : 1;
    vertical-stretch: root.vertical ? 1 : 0;
}

export component PanelHeading inherits Rectangle {
    in property <string> title: "Heading";
    in property <string> detail: "";
    background: transparent;
    height: root.detail == "" ? 34px : 52px;

    Text {
        x: 0px;
        y: 7px;
        width: parent.width;
        height: 22px;
        text: root.title;
        color: Theme.text-primary;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: -0.1px;
        vertical-alignment: center;
    }

    Text {
        x: 0px;
        y: 30px;
        width: parent.width;
        height: 18px;
        text: root.detail;
        visible: root.detail != "";
        color: Theme.text-secondary;
        font-size: 11px;
        overflow: elide;
        vertical-alignment: center;
    }
}

export component SectionTitle inherits Rectangle {
    in property <int> step: 0;
    in property <string> title: "SECTION";
    in property <string> trailing: "";
    background: transparent;
    height: 32px;

    // The step numeral is retired visually; breathing room above every
    // section is baked in so the column keeps a uniform stack spacing.
    Text {
        x: 0px;
        y: 12px;
        width: parent.width * 0.6;
        height: 16px;
        text: root.title;
        color: Theme.text-tertiary;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.7px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width * 0.6;
        y: 12px;
        width: parent.width * 0.4;
        height: 16px;
        text: root.trailing;
        color: Theme.text-tertiary;
        font-size: 11px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component FlatButton inherits Rectangle {
    in property <string> text: "Button";
    in property <bool> active: true;
    in property <bool> primary: false;
    in property <bool> compact: false;
    in property <bool> selected: false;
    in property <bool> destructive: false;
    in property <bool> chip: false;
    callback clicked();

    height: root.compact ? 28px : 34px;
    min-width: 72px;
    border-width: 1px;
    border-color: !root.active ? #FFFFFF0A :
        button-focus.has-focus ? Theme.focus :
        root.destructive ? Theme.error-border :
        root.selected ? Theme.accent-border-sel :
        root.primary ? transparent :
        button-touch.has-hover ? Theme.border-control-hover : Theme.border-control;
    border-radius: 6px;
    background: !root.active ? Theme.bg-disabled :
        root.destructive ? (button-touch.has-hover ? #361F20 : Theme.error-bg) :
        root.primary ? (button-touch.pressed ? Theme.accent-gradient-pressed :
            button-touch.has-hover ? Theme.accent-gradient-hover : Theme.accent-gradient) :
        root.selected ? Theme.accent-tint12 :
        button-touch.pressed ? Theme.bg-pressed :
        button-touch.has-hover ? Theme.bg-hover : Theme.bg-raised;
    drop-shadow-blur: button-focus.has-focus ? 4px : 0px;
    drop-shadow-color: Theme.focus-glow;
    clip: true;
    forward-focus: button-focus;
    animate background, border-color { duration: 120ms; easing: ease; }

    accessible-role: button;
    accessible-enabled: root.active;
    accessible-label: root.text;
    accessible-action-default => {
        if (root.active) {
            root.clicked();
        }
    }

    if root.primary && root.active && !root.destructive: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: 1px;
        background: #FFFFFF1A;
    }

    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.text;
        color: !root.active ? Theme.text-disabled :
            root.destructive ? Theme.error-text :
            root.selected ? Theme.text-accent :
            root.primary ? #FFFFFF : Theme.text-primary;
        font-size: root.chip ? 11px : root.compact ? 12px : 13px;
        font-weight: root.primary || root.selected ||
            (root.destructive && !root.compact) ? 600 : 500;
        letter-spacing: root.primary ? 0.1px : 0px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    button-focus := FocusScope {
        key-pressed(event) => {
            if (root.active && event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }

        button-touch := TouchArea {
            enabled: root.active;
            mouse-cursor: pointer;
            clicked => {
                button-focus.focus();
                root.clicked();
            }
        }
    }
}

// Segment of the toolbar page switcher: a chip inside a recessed housing.
export component ToolbarButton inherits Rectangle {
    in property <string> text: "Toolbar";
    in property <bool> active: true;
    in property <bool> selected: false;
    in property <string> badge: "";
    callback clicked();

    height: 24px;
    horizontal-stretch: 0;
    border-radius: 5px;
    background: !root.active ? transparent :
        root.selected ? #393E47 :
        touch.pressed ? #32363F :
        touch.has-hover ? #FFFFFF0A : transparent;
    clip: true;
    animate background { duration: 120ms; easing: ease; }

    accessible-role: button;
    accessible-enabled: root.active;
    accessible-label: root.badge == "" ? root.text : root.text + ", " + root.badge;
    accessible-action-default => {
        if (root.active) {
            root.clicked();
        }
    }

    if root.selected: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: 1px;
        background: #FFFFFF12;
    }

    Text {
        x: 8px;
        width: root.badge == "" ? parent.width - 16px : parent.width - 36px;
        text: root.text;
        color: !root.active ? Theme.text-disabled :
            root.selected ? Theme.text-primary : Theme.text-secondary;
        font-size: 12px;
        font-weight: root.selected ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: parent.width - 26px;
        y: 4px;
        width: 20px;
        height: 16px;
        border-radius: 8px;
        background: Theme.accent-tint18;
        visible: root.badge != "";

        Text {
            text: root.badge;
            color: Theme.text-primary;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.4px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SegmentedButton inherits Rectangle {
    in property <string> text: "Choice";
    in property <bool> selected: false;
    in property <bool> active: true;
    callback clicked();

    height: 24px;
    min-width: 54px;
    border-radius: 5px;
    background: root.selected ? #393E47 :
        touch.pressed && root.active ? #32363F :
        touch.has-hover && root.active ? #FFFFFF0A : transparent;
    clip: true;
    animate background { duration: 120ms; easing: ease; }

    accessible-role: button;
    accessible-enabled: root.active;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-label: root.text;
    accessible-action-default => {
        if (root.active) {
            root.clicked();
        }
    }

    if root.selected: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: 1px;
        background: #FFFFFF12;
    }

    Text {
        text: root.text;
        color: !root.active ? Theme.text-disabled :
            root.selected ? Theme.text-primary : Theme.text-secondary;
        font-size: 12px;
        font-weight: root.selected ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Recessed housing for a row of SegmentedButtons.
export component SegmentedHousing inherits Rectangle {
    height: 30px;
    border-radius: 8px;
    background: Theme.bg-recess;
    border-width: 1px;
    border-color: Theme.border-recess;
}

export component TaskChoice inherits Rectangle {
    in property <string> title: "Task";
    in property <string> detail: "Description";
    in property <string> tag: "";
    in property <bool> selected: false;
    in property <bool> active: true;
    callback clicked();

    height: 72px;
    min-width: 108px;
    border-width: 1px;
    border-color: !root.active ? #FFFFFF0A :
        root.selected ? Theme.accent-border-sel :
        touch.has-hover ? Theme.border-control-hover : Theme.border-control;
    border-radius: 8px;
    background: !root.active ? Theme.bg-disabled :
        root.selected ? Theme.accent-tint12 :
        touch.pressed ? Theme.bg-pressed :
        touch.has-hover ? Theme.bg-hover : Theme.bg-raised;
    animate background, border-color { duration: 150ms; easing: ease-out; }

    accessible-role: button;
    accessible-enabled: root.active;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-label: root.title + ". " + root.detail;
    accessible-action-default => {
        if (root.active) {
            root.clicked();
        }
    }

    Rectangle {
        x: 12px;
        y: 12px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: 1px;
        border-color: root.selected ? #6A9EFE : #FFFFFF1C;
        background: root.selected ? Theme.accent-gradient : Theme.bg-recess;

        Rectangle {
            x: 5px;
            y: 5px;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: white;
            visible: root.selected;
        }
    }

    Text {
        x: 34px;
        y: 9px;
        width: parent.width - 46px;
        height: 20px;
        text: root.title;
        color: root.active ? Theme.text-primary : Theme.text-disabled;
        font-size: 13px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 12px;
        y: 34px;
        width: parent.width - 24px;
        height: 34px;
        text: root.detail;
        color: !root.active ? Theme.text-disabled :
            root.selected ? #B9CDF1 : Theme.text-secondary;
        font-size: 11px;
        wrap: word-wrap;
    }

    Rectangle {
        x: parent.width - 49px;
        y: 10px;
        width: 37px;
        height: 16px;
        border-radius: 8px;
        background: #FFFFFF10;
        visible: root.tag != "";

        Text {
            text: root.tag;
            color: Theme.text-secondary;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.4px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component RecipeChoice inherits Rectangle {
    in property <string> title: "Quick Start";
    in property <string> detail: "Balanced result";
    in property <bool> active: true;
    in property <bool> primary: false;
    callback clicked();

    height: 56px;
    border-width: 1px;
    border-color: !root.active ? #FFFFFF0A :
        root.primary ? transparent :
        touch.has-hover ? Theme.border-control-hover : Theme.border-control;
    border-radius: 8px;
    background: !root.active ? Theme.bg-disabled :
        root.primary ? (touch.pressed ? Theme.accent-gradient-pressed :
            touch.has-hover ? Theme.accent-gradient-hover : Theme.accent-gradient) :
        touch.pressed ? Theme.bg-pressed :
        touch.has-hover ? Theme.bg-hover : Theme.bg-raised;
    clip: true;
    animate background, border-color { duration: 120ms; easing: ease; }

    accessible-role: button;
    accessible-enabled: root.active;
    accessible-label: root.title + ". " + root.detail;
    accessible-action-default => {
        if (root.active) {
            root.clicked();
        }
    }

    if root.primary && root.active: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: 1px;
        background: #FFFFFF1A;
    }

    Text {
        x: 13px;
        y: 8px;
        width: parent.width - 44px;
        height: 20px;
        text: root.title;
        color: !root.active ? Theme.text-disabled :
            root.primary ? #FFFFFF : Theme.text-primary;
        font-size: 13px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 13px;
        y: 30px;
        width: parent.width - 44px;
        height: 18px;
        text: root.detail;
        color: !root.active ? Theme.text-disabled :
            root.primary ? Theme.text-on-accent-secondary : Theme.text-secondary;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 24px + (touch.has-hover && root.active ? 2px : 0px);
        width: 14px;
        height: parent.height;
        text: "›";
        visible: root.active;
        color: root.primary ? #DCE9FF : Theme.text-tertiary;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate x { duration: 120ms; easing: ease-out; }
    }

    touch := TouchArea {
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component DisclosureRow inherits Rectangle {
    in property <string> text: "Advanced";
    in property <string> summary: "";
    in property <bool> open: false;
    in property <bool> active: true;
    callback toggled();

    height: 36px;
    border-radius: 6px;
    background: touch.pressed && root.active ? #FFFFFF0C :
        touch.has-hover && root.active ? Theme.bg-row-hover : transparent;
    border-width: focus-scope.has-focus ? 1px : 0px;
    border-color: Theme.focus;
    forward-focus: focus-scope;
    animate background { duration: 120ms; easing: ease; }

    accessible-role: button;
    accessible-enabled: root.active;
    accessible-label: root.text;
    accessible-action-default => {
        if (root.active) {
            root.toggled();
        }
    }

    Text {
        x: 8px;
        width: parent.width * 0.44;
        text: root.text;
        color: root.active ? Theme.text-primary : Theme.text-disabled;
        font-size: 13px;
        font-weight: root.open ? 600 : 500;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width * 0.44;
        width: parent.width * 0.56 - 30px;
        text: root.summary;
        color: Theme.text-tertiary;
        font-size: 11px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    // Caret ink hugs one edge of its em box; a 2px counter-offset keeps
    // both states on the row's optical centerline.
    Text {
        x: parent.width - 22px;
        y: (parent.height - 16px) / 2 + (root.open ? 2px : -2px);
        width: 18px;
        height: 16px;
        text: root.open ? "⌃" : "⌄";
        color: root.open ? Theme.text-primary : Theme.text-secondary;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    focus-scope := FocusScope {
        key-pressed(event) => {
            if (root.active && event.text == Key.Return) {
                root.toggled();
                return accept;
            }
            return reject;
        }

        touch := TouchArea {
            enabled: root.active;
            mouse-cursor: pointer;
            clicked => { root.toggled(); }
        }
    }
}

export component CheckControl inherits Rectangle {
    in property <string> text: "Option";
    in property <bool> checked: false;
    in property <bool> active: true;
    callback toggled(bool);

    height: 30px;
    background: transparent;

    accessible-role: checkbox;
    accessible-enabled: root.active;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-action-default => {
        if (root.active) {
            root.toggled(!root.checked);
        }
    }

    Rectangle {
        x: 1px;
        y: 7px;
        width: 16px;
        height: 16px;
        border-radius: 4px;
        border-width: 1px;
        border-color: !root.active ? Theme.border-control :
            root.checked ? #6A9EFE :
            touch.has-hover ? #FFFFFF24 : #FFFFFF1C;
        background: !root.active ? Theme.bg-disabled :
            root.checked ? Theme.accent-gradient : Theme.bg-recess;
        animate background, border-color { duration: 120ms; easing: ease; }

        Text {
            text: root.checked ? "✓" : "";
            color: root.active ? white : #FFFFFF59;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 26px;
        width: parent.width - 26px;
        text: root.text;
        color: root.active ? Theme.text-primary : Theme.text-disabled;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

export component ProgressTrack inherits Rectangle {
    in property <float> value: 0;
    in property <brush> fill-color: Theme.accent;
    in property <color> track-color: #FFFFFF0B;
    horizontal-stretch: 1;
    height: 4px;
    border-radius: 2px;
    background: root.track-color;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: max(0px, min(parent.width, parent.width * root.value));
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.fill-color;
        animate width { duration: 140ms; easing: linear; }
    }
}

export component FieldLabel inherits Text {
    in property <string> label: "Label";
    text: root.label;
    color: Theme.text-secondary;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1px;
    height: 18px;
    vertical-alignment: center;
}

export component ValueLine inherits Rectangle {
    in property <string> label: "Label";
    in property <string> value: "—";
    in property <bool> placeholder: false;
    background: transparent;
    height: 26px;

    Text {
        x: 0px;
        width: 45%;
        text: root.label;
        color: Theme.text-secondary;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: parent.width * 0.45;
        width: 55%;
        text: root.value;
        color: root.placeholder || root.value == "—" ?
            Theme.text-disabled : Theme.text-primary;
        font-size: 12px;
        font-weight: 500;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A saved custom recipe: applies its snapshot on click, deletes via the disc.
export component CustomRecipeRow inherits Rectangle {
    in property <string> title: "Recipe";
    in property <string> detail: "";
    in property <bool> active: true;
    callback clicked();
    callback removed();

    height: 52px;
    border-width: 1px;
    border-color: !root.active ? #FFFFFF0A :
        row-touch.has-hover ? Theme.border-control-hover : Theme.border-control;
    border-radius: 8px;
    background: !root.active ? Theme.bg-disabled :
        row-touch.pressed ? Theme.bg-pressed :
        row-touch.has-hover ? Theme.bg-hover : Theme.bg-raised;
    animate background, border-color { duration: 120ms; easing: ease; }

    accessible-role: button;
    accessible-enabled: root.active;
    accessible-label: root.title + ". " + root.detail;
    accessible-action-default => {
        if (root.active) {
            root.clicked();
        }
    }

    Text {
        x: 13px;
        y: 8px;
        width: parent.width - 56px;
        height: 18px;
        text: root.title;
        color: root.active ? Theme.text-primary : Theme.text-disabled;
        font-size: 13px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 13px;
        y: 28px;
        width: parent.width - 56px;
        height: 16px;
        text: root.detail;
        color: root.active ? Theme.text-secondary : Theme.text-disabled;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: parent.width - 34px;
        y: (parent.height - 22px) / 2;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: remove-touch.pressed ? #E5484D4D :
            remove-touch.has-hover ? #E5484D33 : #FFFFFF10;
        opacity: row-touch.has-hover || remove-touch.has-hover ? 1 : 0;
        animate opacity { duration: 120ms; easing: ease; }

        Text {
            text: "✕";
            color: remove-touch.has-hover || remove-touch.pressed ?
                Theme.error-text : Theme.text-secondary;
            font-size: 10px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    row-touch := TouchArea {
        width: parent.width - 44px;
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    remove-touch := TouchArea {
        x: parent.width - 44px;
        width: 44px;
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => { root.removed(); }
    }
}

// A quiet ⓘ that opens a floating explainer on click.
export component InfoDot inherits Rectangle {
    in property <string> tip: "";
    in property <length> tip-width: 264px;
    in property <length> tip-height: 168px;

    width: 16px;
    height: 16px;
    border-radius: 8px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border-control-hover : Theme.border-control;
    background: touch.has-hover ? #FFFFFF14 : transparent;
    animate background, border-color { duration: 120ms; easing: ease; }

    accessible-role: button;
    accessible-label: "More information";
    accessible-action-default => { tip-popup.show(); }

    Text {
        text: "i";
        color: touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        font-size: 10px;
        font-italic: true;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { tip-popup.show(); }
    }

    tip-popup := PopupWindow {
        x: root.width + 6px - root.tip-width;
        y: root.height + 6px;
        width: root.tip-width;
        height: root.tip-height;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.bg-raised;
            border-width: 1px;
            border-color: #FFFFFF15;
            border-radius: 8px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000A6;
            drop-shadow-offset-y: 8px;

            ScrollView {
                x: 6px;
                y: 6px;
                width: parent.width - 12px;
                height: parent.height - 12px;
                viewport-width: self.width;

                VerticalLayout {
                    padding: 8px;

                    Text {
                        text: root.tip;
                        color: Theme.text-primary;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

// Small glyph button for the floating zoom HUD.
export component HudButton inherits Rectangle {
    in property <string> glyph: "+";
    in property <string> label: "Button";
    in property <length> glyph-size: 12px;
    in property <bool> active: true;
    callback clicked();

    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: !root.active ? transparent :
        touch.pressed ? #FFFFFF1C :
        touch.has-hover ? #FFFFFF12 : transparent;
    animate background { duration: 120ms; easing: ease; }

    accessible-role: button;
    accessible-enabled: root.active;
    accessible-label: root.label;
    accessible-action-default => {
        if (root.active) {
            root.clicked();
        }
    }

    Text {
        text: root.glyph;
        color: !root.active ? Theme.text-disabled :
            touch.has-hover ? Theme.text-primary : #C8CBD1;
        font-size: root.glyph-size;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
