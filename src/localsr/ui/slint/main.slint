import { AboutSlint, ListView, ScrollView } from "std-widgets.slint";
import {
    CheckControl,
    CustomRecipeRow,
    DesktopComboBox,
    DisclosureRow,
    FieldLabel,
    FlatButton,
    HudButton,
    InfoDot,
    PanelHeading,
    ProgressTrack,
    RecipeChoice,
    SectionTitle,
    SegmentedButton,
    SegmentedHousing,
    TaskChoice,
    Theme,
    ThinSeparator,
    ToolbarButton,
    ValueLine
} from "components.slint";

export struct QueueEntry {
    name: string,
    detail: string,
    selected: bool,
    thumbnail: image,
    has-thumbnail: bool,
}

export struct RecipeEntry {
    name: string,
    detail: string,
}

// "Machined Graphite": four tonal planes joined by shadow + catch-light
// seams under one top-left light. Chrome (toolbar, dock, status) is nearest,
// panels sit below it, the preview stage below that, and the canvas well is
// carved deepest. Floating glass (zoom HUD, compare chips, popups) is the
// only layer that casts shadows.
export component MainWindow inherits Window {
    title: root.selected-name == "" ? "LocalSR" : root.selected-name + " — LocalSR";
    preferred-width: 1480px;
    preferred-height: 900px;
    min-width: 820px;
    min-height: 620px;
    background: Theme.bg-base;

    // Three content-fit modes, expressed in logical pixels. Slint applies the
    // native display scale, so these breakpoints work at 1× and HiDPI alike.
    // The indirection keeps the binding responsive to the live window while
    // also making breakpoint behavior testable without opening a window.
    in-out property <length> layout-width: root.width;
    out property <int> layout-mode:
        root.layout-width < 920px ? 2 : root.layout-width < 1280px ? 1 : 0;
    in-out property <int> compact-page: 1; // 0 Media, 1 Preview, 2 Enhance
    out property <bool> media-pane-visible:
        root.layout-mode == 0 || root.layout-mode == 1 || root.compact-page == 0;
    out property <bool> preview-pane-visible:
        root.layout-mode == 0 ||
        (root.layout-mode == 1 && root.compact-page != 2) ||
        (root.layout-mode == 2 && root.compact-page == 1);
    out property <bool> enhance-pane-visible:
        root.layout-mode == 0 || root.compact-page == 2;
    in-out property <bool> comparison-enabled: true;
    in-out property <bool> video-enabled: false;

    in-out property <bool> batch-mode: false;
    in-out property <bool> controls-enabled: true;
    in-out property <bool> model-selection-enabled: true;
    in-out property <[QueueEntry]> queue-items;
    in-out property <bool> task-selected: false;
    in-out property <int> task-index: -1;
    in-out property <[string]> model-options;
    in-out property <int> model-index: 0;
    in-out property <string> model-description: "Choose a task first.";
    in-out property <string> model-status: "Waiting for worker.";
    in-out property <string> model-action-text: "Download Model";
    in-out property <bool> model-action-visible: false;
    in-out property <bool> model-action-enabled: true;
    in-out property <bool> download-visible: false;
    in-out property <float> download-progress: 0;

    in-out property <[string]> scale-options;
    in-out property <int> scale-index: 0;
    in-out property <[string]> format-options: ["PNG", "JPEG", "TIFF"];
    in-out property <int> format-index: 0;
    in-out property <string> output-directory: "";
    in-out property <bool> preserve-metadata: true;
    in-out property <int> jpeg-quality: 98;

    in-out property <[string]> device-options;
    in-out property <int> device-index: 0;
    in-out property <string> hardware-summary: "Hardware detection is starting.";
    in-out property <string> memory-usage-text: "Memory unavailable";
    in-out property <float> memory-usage-ratio: 0;
    in-out property <string> pressure-text: "Checking pressure";
    in-out property <brush> pressure-color: #8B8E94;

    in-out property <string> estimate-time: "—";
    in-out property <string> estimate-output: "—";
    in-out property <string> estimate-detail: "Choose an image and model.";
    in-out property <string> estimate-warning: "";

    in-out property <bool> advanced-open: false;
    in-out property <string> app-version: "unknown";
    in-out property <[string]> tile-options;
    in-out property <int> tile-index: 0;
    in-out property <[string]> halo-options;
    in-out property <int> halo-index: 0;
    in-out property <[string]> precision-options;
    in-out property <int> precision-index: 0;
    in-out property <bool> safe-memory: false;
    in-out property <bool> safe-memory-enabled: true;
    in-out property <[RecipeEntry]> custom-recipes;
    in-out property <bool> recipe-editor-open: false;
    in-out property <string> recipe-name-draft: "";
    in-out property <string> model-info-text: "";

    // Presentation strings kept separate so filenames and dimensions can use
    // the correct hierarchy instead of being parsed from a multiline summary.
    in-out property <string> selected-name: "";
    in-out property <string> selected-detail: "No image selected";
    in-out property <string> output-dimensions: "—";
    in-out property <string> input-summary: "No image selected";
    in-out property <string> task-summary: "Choose a task";
    in-out property <string> profile-summary: "—";
    in-out property <string> model-summary: "—";
    in-out property <string> scale-summary: "—";
    in-out property <string> output-summary: "—";
    in-out property <string> device-summary: "Detecting hardware";

    in-out property <image> source-image;
    in-out property <image> result-image;
    in-out property <bool> image-ready: false;
    in-out property <bool> live-result-ready: false;
    in-out property <bool> result-ready: false;
    in-out property <string> source-label: "Original";
    in-out property <string> result-label: "Preview";
    in-out property <float> preview-aspect: 1;
    in-out property <float> compare-position: 0.5;
    in-out property <float> preview-zoom: 1;
    in-out property <length> preview-pan-x: 0px;
    in-out property <length> preview-pan-y: 0px;
    in-out property <bool> tile-active: false;
    in-out property <float> tile-x: 0;
    in-out property <float> tile-y: 0;
    in-out property <float> tile-width: 0;
    in-out property <float> tile-height: 0;

    in-out property <float> progress: 0;
    in-out property <string> status-title: "Ready";
    in-out property <string> status-detail: "Add an image, then choose a task.";
    in-out property <string> batch-progress: "";
    in-out property <bool> can-start: false;
    in-out property <bool> can-cancel: false;
    in-out property <bool> can-open-result: false;
    in-out property <string> action-text: "Start";

    callback poll-backend();
    callback choose-images();
    callback choose-folder();
    callback clear-queue();
    callback remove-queue-item(int);
    callback select-queue-item(int);
    callback task-changed(int);
    callback model-changed(int);
    callback quick-setup();
    callback best-setup();
    callback model-action();
    callback scale-changed(int);
    callback format-changed(int);
    callback choose-output-directory();
    callback preserve-metadata-changed(bool);
    callback device-changed(int);
    callback refresh-hardware();
    callback tile-changed(int);
    callback halo-changed(int);
    callback precision-changed(int);
    callback safe-memory-changed(bool);
    callback jpeg-quality-changed(int);
    callback start-job();
    callback cancel-job();
    callback open-result();
    callback reveal-result();
    callback save-recipe(string);
    callback apply-recipe(int);
    callback delete-recipe(int);
    callback copy-diagnostics();

    in-out property <bool> deflicker: false;

    Timer {
        interval: 50ms;
        running: true;
        triggered => { root.poll-backend(); }
    }

    VerticalLayout {
        spacing: 0px;

        // Chassis rim: a quiet command strip. The OS title bar remains the
        // only branded header. Compact layouts get a centered page switcher.
        Rectangle {
            height: 46px;
            background: Theme.bg-chrome;

            if root.layout-mode > 0: SegmentedHousing {
                x: (parent.width - self.width) / 2;
                y: 8px;
                width: root.layout-mode == 2 ? 278px : 180px;

                HorizontalLayout {
                    x: 3px;
                    y: 3px;
                    height: 24px;
                    spacing: 2px;

                    if root.layout-mode == 2: ToolbarButton {
                        text: "Media";
                        width: 96px;
                        selected: root.compact-page == 0;
                        badge: root.queue-items.length == 0 ? "" :
                            root.queue-items.length > 99 ? "99+" :
                            "" + root.queue-items.length;
                        clicked => { root.compact-page = 0; }
                    }

                    ToolbarButton {
                        text: "Preview";
                        width: 84px;
                        selected: root.compact-page == 1;
                        clicked => { root.compact-page = 1; }
                    }

                    ToolbarButton {
                        text: "Enhance";
                        width: 88px;
                        selected: root.compact-page == 2;
                        clicked => { root.compact-page = 2; }
                    }
                }
            }

            FlatButton {
                x: parent.width - 16px - self.width;
                y: 8px;
                width: 126px;
                height: 30px;
                text: "+  Add Media";
                primary: true;
                compact: true;
                active: root.controls-enabled;
                clicked => { root.choose-images(); }
            }

            Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.sep-light; }
            Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.sep-shadow; }
        }

        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // Media is persistent on wide/medium windows and becomes a full
            // workspace page when the available width is compact.
            if root.media-pane-visible: Rectangle {
                width: root.layout-mode == 2 ? root.width : 276px;
                horizontal-stretch: 0;
                background: Theme.bg-panel;

                VerticalLayout {
                    x: root.layout-mode == 2 ?
                        (parent.width - min(420px, parent.width)) / 2 : 0px;
                    width: root.layout-mode == 2 ? min(420px, parent.width) : parent.width;
                    height: parent.height;
                    spacing: 0px;

                    Rectangle {
                        height: 48px;
                        background: transparent;

                        Text {
                            x: 16px;
                            y: 14px;
                            width: parent.width * 0.5 - 16px;
                            height: 20px;
                            text: "Media";
                            color: Theme.text-primary;
                            font-size: 15px;
                            font-weight: 600;
                            letter-spacing: -0.1px;
                            vertical-alignment: center;
                        }

                        Text {
                            x: parent.width * 0.5;
                            y: 16px;
                            width: parent.width * 0.5 - 16px;
                            height: 16px;
                            text: root.queue-items.length == 0 ? "No images" :
                                root.queue-items.length +
                                    (root.queue-items.length == 1 ? " image" : " images");
                            color: Theme.text-tertiary;
                            font-size: 11px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }

                    SegmentedHousing {
                        x: 12px;
                        width: parent.width - 24px;

                        HorizontalLayout {
                            x: 3px;
                            y: 3px;
                            width: parent.width - 6px;
                            height: 24px;
                            spacing: 2px;

                            SegmentedButton {
                                text: "Single";
                                selected: !root.batch-mode;
                                active: root.controls-enabled;
                                clicked => { root.batch-mode = false; }
                            }
                            SegmentedButton {
                                text: "Batch";
                                selected: root.batch-mode;
                                active: root.controls-enabled;
                                clicked => { root.batch-mode = true; }
                            }
                        }
                    }

                    Rectangle { height: 12px; background: transparent; }

                    if root.queue-items.length == 0: Rectangle {
                        x: 12px;
                        width: parent.width - 24px;
                        height: 132px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #FFFFFF0A;
                        background: #FFFFFF05;

                        Rectangle {
                            x: (parent.width - 28px) / 2;
                            y: 14px;
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: Theme.bg-raised;
                            border-width: 1px;
                            border-color: Theme.border-control;

                            Rectangle {
                                x: 8px;
                                y: 13px;
                                width: 12px;
                                height: 2px;
                                border-radius: 1px;
                                background: #C8CBD1;
                            }
                            Rectangle {
                                x: 13px;
                                y: 8px;
                                width: 2px;
                                height: 12px;
                                border-radius: 1px;
                                background: #C8CBD1;
                            }
                        }

                        Text {
                            x: 12px;
                            y: 50px;
                            width: parent.width - 24px;
                            height: 20px;
                            text: "Add media";
                            color: Theme.text-primary;
                            font-size: 13px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        Text {
                            x: 12px;
                            y: 72px;
                            width: parent.width - 24px;
                            height: 16px;
                            text: "Images, camera RAW, or video clips";
                            color: Theme.text-tertiary;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        FlatButton {
                            x: (parent.width - 104px) / 2;
                            y: 94px;
                            width: 104px;
                            text: "Choose…";
                            compact: true;
                            active: root.controls-enabled;
                            clicked => { root.choose-images(); }
                        }
                    }

                    if root.queue-items.length > 0: ListView {
                        x: 8px;
                        width: parent.width - 16px;
                        vertical-stretch: 1;

                        for item[index] in root.queue-items: Rectangle {
                            height: 64px;
                            width: parent.width;
                            border-radius: 8px;
                            background: item.selected ?
                                (row-touch.has-hover ? #4E8CFF3D : Theme.accent-tint18) :
                                row-touch.has-hover ? Theme.bg-row-hover : transparent;
                            animate background { duration: 150ms; easing: ease-out; }

                            Rectangle {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                width: 3px;
                                height: item.selected ? 48px : 12px;
                                border-radius: 1.5px;
                                background: @linear-gradient(180deg, #6A9EFE 0%, #4E8CFF 100%);
                                opacity: item.selected ? 1 : 0;
                                animate height { duration: 140ms; easing: ease-out; }
                                animate opacity { duration: 140ms; easing: ease-out; }
                            }

                            Rectangle {
                                x: 10px;
                                y: 10px;
                                width: 44px;
                                height: 44px;
                                border-radius: 6px;
                                background: Theme.bg-raised;
                                border-width: 1px;
                                border-color: item.selected ? #4E8CFF66 : Theme.border-control;
                                clip: true;

                                Image {
                                    source: item.thumbnail;
                                    width: parent.width;
                                    height: parent.height;
                                    image-fit: cover;
                                    visible: item.has-thumbnail;
                                }

                                Text {
                                    text: "IMG";
                                    color: item.selected ? #B9CDF1 : Theme.text-tertiary;
                                    font-size: 9px;
                                    font-weight: 600;
                                    letter-spacing: 0.5px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    visible: !item.has-thumbnail;
                                }
                            }

                            Text {
                                x: 64px;
                                y: 10px;
                                width: parent.width - 120px;
                                height: 20px;
                                text: item.name;
                                color: Theme.text-primary;
                                font-size: 13px;
                                font-weight: item.selected ? 600 : 500;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            Text {
                                x: 64px;
                                y: 33px;
                                width: parent.width - 120px;
                                height: 16px;
                                text: item.detail;
                                color: Theme.text-secondary;
                                font-size: 11px;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                x: parent.width - 43px;
                                y: 21px;
                                width: 22px;
                                height: 22px;
                                border-radius: 11px;
                                background: remove-touch.pressed ? #E5484D4D :
                                    remove-touch.has-hover ? #E5484D33 : #FFFFFF10;
                                opacity: row-touch.has-hover || remove-touch.has-hover ||
                                    item.selected || root.layout-mode == 2 ? 1 : 0;
                                animate opacity { duration: 120ms; easing: ease; }

                                Text {
                                    text: "✕";
                                    color: remove-touch.has-hover || remove-touch.pressed ?
                                        Theme.error-text : Theme.text-secondary;
                                    font-size: 10px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            row-touch := TouchArea {
                                width: parent.width - 64px;
                                enabled: root.controls-enabled;
                                mouse-cursor: pointer;
                                clicked => { root.select-queue-item(index); }
                            }

                            remove-touch := TouchArea {
                                x: parent.width - 64px;
                                width: 64px;
                                enabled: root.controls-enabled;
                                mouse-cursor: pointer;
                                clicked => { root.remove-queue-item(index); }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: root.queue-items.length == 0 ? 1 : 0; background: transparent; }

                    Rectangle {
                        height: 48px;
                        background: Theme.bg-panel;
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: 1px;
                            background: Theme.sep-inset;
                            visible: root.layout-mode != 2;
                        }

                        FlatButton {
                            x: 12px;
                            y: 10px;
                            width: 104px;
                            text: root.batch-mode ? "Add More…" : "Replace…";
                            compact: true;
                            active: root.controls-enabled;
                            visible: root.queue-items.length > 0;
                            clicked => { root.choose-images(); }
                        }

                        FlatButton {
                            x: 12px;
                            y: 10px;
                            width: 112px;
                            text: "Add Folder…";
                            compact: true;
                            active: root.controls-enabled;
                            visible: root.batch-mode && root.queue-items.length == 0;
                            clicked => { root.choose-folder(); }
                        }

                        FlatButton {
                            x: parent.width - 76px;
                            y: 10px;
                            width: 64px;
                            text: "Clear";
                            compact: true;
                            active: root.controls-enabled && root.queue-items.length > 0;
                            visible: root.queue-items.length > 0;
                            clicked => { root.clear-queue(); }
                        }
                    }
                }

                Rectangle {
                    x: 0px;
                    y: parent.height - 48px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.sep-inset;
                    visible: root.layout-mode == 2;
                }

                // Seam toward the darker preview stage: catch-light on this,
                // the lighter plane; the preview pane carries the shadow.
                Rectangle {
                    x: parent.width - 1px;
                    y: 0px;
                    width: 1px;
                    height: parent.height;
                    background: Theme.sep-light;
                    visible: root.layout-mode == 0 ||
                        (root.layout-mode == 1 && root.compact-page != 2);
                }
            }

            // The document stage remains dominant. Existing aspect-correct fit,
            // progressive tiles, zoom-at-pointer, panning, and completed-result
            // comparison behavior are preserved.
            if root.preview-pane-visible: Rectangle {
                horizontal-stretch: 1;
                min-width: 420px;
                background: Theme.bg-base;

                VerticalLayout {
                    spacing: 0px;

                    Rectangle {
                        height: 44px;
                        background: transparent;

                        Text {
                            x: 16px;
                            width: parent.width * 0.62;
                            height: parent.height;
                            text: root.selected-name == "" ? "Preview" : root.selected-name;
                            color: Theme.text-primary;
                            font-size: 13px;
                            font-weight: 600;
                            overflow: elide;
                            vertical-alignment: center;
                        }

                        Text {
                            x: parent.width * 0.62;
                            width: parent.width * 0.38 - 16px;
                            height: parent.height;
                            text: root.image-ready ? root.selected-detail : "";
                            color: Theme.text-secondary;
                            font-size: 11px;
                            horizontal-alignment: right;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: transparent;

                        // The carved well: a 1px rim reveal around a recessed
                        // stage that sits physically below the window surface.
                        well-outer := Rectangle {
                            x: 16px;
                            y: 16px;
                            width: parent.width - 32px;
                            height: parent.height - 32px;
                            border-radius: 8px;
                            background: #FFFFFF08;

                            canvas := Rectangle {
                                x: 1px;
                                y: 1px;
                                width: parent.width - 2px;
                                height: parent.height - 2px;
                                background: Theme.bg-stage;
                                border-width: 1px;
                                border-color: #000000E0;
                                border-radius: 7px;
                                clip: true;

                                property <length> fit-width: min(
                                    self.width,
                                    self.height * max(0.01, root.preview-aspect)
                                );
                                property <length> fit-height:
                                    self.fit-width / max(0.01, root.preview-aspect);
                                property <length> max-pan-x: max(
                                    0px,
                                    (self.fit-width * root.preview-zoom - self.width) / 2
                                );
                                property <length> max-pan-y: max(
                                    0px,
                                    (self.fit-height * root.preview-zoom - self.height) / 2
                                );

                                preview-content := Rectangle {
                                    x: (parent.width - self.width) / 2 + root.preview-pan-x;
                                    y: (parent.height - self.height) / 2 + root.preview-pan-y;
                                    width: parent.fit-width * root.preview-zoom;
                                    height: parent.fit-height * root.preview-zoom;
                                    background: Theme.bg-stage;

                                    Image {
                                        x: 0px;
                                        y: 0px;
                                        source: root.source-image;
                                        width: parent.width;
                                        height: parent.height;
                                        image-fit: fill;
                                        visible: root.image-ready;
                                    }

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        width: root.result-ready && root.comparison-enabled ?
                                            parent.width * root.compare-position : parent.width;
                                        height: parent.height;
                                        clip: true;
                                        background: transparent;
                                        visible: root.live-result-ready;

                                        Image {
                                            x: 0px;
                                            y: 0px;
                                            source: root.result-image;
                                            width: preview-content.width;
                                            height: preview-content.height;
                                            image-fit: fill;
                                        }
                                    }

                                    Rectangle {
                                        x: root.tile-x * parent.width;
                                        y: root.tile-y * parent.height;
                                        width: root.tile-width * parent.width;
                                        height: root.tile-height * parent.height;
                                        background: #4E8CFF1A;
                                        border-width: 2px / root.preview-zoom;
                                        border-color: #6A9EFE;
                                        visible: root.tile-active;
                                    }

                                    Rectangle {
                                        x: parent.width * root.compare-position - 1px;
                                        y: 0px;
                                        width: 2px;
                                        height: parent.height;
                                        background: #F5F6F8;
                                        visible: root.result-ready && root.comparison-enabled &&
                                            !root.tile-active;

                                        Rectangle { x: -1px; y: 0px; width: 1px; height: parent.height; background: #00000059; }
                                        Rectangle { x: 2px; y: 0px; width: 1px; height: parent.height; background: #00000059; }

                                        Rectangle {
                                            x: -14px;
                                            y: parent.height / 2 - 15px;
                                            width: 30px;
                                            height: 30px;
                                            border-radius: 15px;
                                            border-width: 1px;
                                            border-color: preview-touch.dragging-divider ?
                                                Theme.focus : #FFFFFF29;
                                            background: #1B1D22F2;
                                            drop-shadow-blur: preview-touch.dragging-divider ? 10px : 12px;
                                            drop-shadow-color: preview-touch.dragging-divider ?
                                                #4E8CFF59 : #00000080;
                                            drop-shadow-offset-y: 2px;

                                            Text {
                                                text: "‹ ›";
                                                color: Theme.text-primary;
                                                font-size: 11px;
                                                font-weight: 500;
                                                letter-spacing: 2px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // Vignette: the well's walls shade the image
                                // edges so the recess reads as physical depth.
                                Rectangle {
                                    x: 0px; y: 0px; width: parent.width; height: 14px;
                                    background: @linear-gradient(180deg, #00000059 0%, transparent 100%);
                                }
                                Rectangle {
                                    x: 0px; y: parent.height - 10px; width: parent.width; height: 10px;
                                    background: @linear-gradient(180deg, transparent 0%, #00000040 100%);
                                }
                                Rectangle {
                                    x: 0px; y: 0px; width: 10px; height: parent.height;
                                    background: @linear-gradient(90deg, #00000040 0%, transparent 100%);
                                }
                                Rectangle {
                                    x: parent.width - 10px; y: 0px; width: 10px; height: parent.height;
                                    background: @linear-gradient(90deg, transparent 0%, #00000040 100%);
                                }

                                if !root.image-ready: Rectangle {
                                    x: (parent.width - min(400px, parent.width - 48px)) / 2;
                                    y: (parent.height - 204px) / 2;
                                    width: min(400px, parent.width - 48px);
                                    height: 204px;
                                    background: transparent;

                                    Rectangle {
                                        x: (parent.width - 44px) / 2;
                                        y: 0px;
                                        width: 44px;
                                        height: 44px;
                                        border-radius: 22px;
                                        background: Theme.bg-raised;
                                        border-width: 1px;
                                        border-color: Theme.border-control;

                                        Rectangle {
                                            x: 13px;
                                            y: 21px;
                                            width: 18px;
                                            height: 2px;
                                            border-radius: 1px;
                                            background: #C8CBD1;
                                        }
                                        Rectangle {
                                            x: 21px;
                                            y: 13px;
                                            width: 2px;
                                            height: 18px;
                                            border-radius: 1px;
                                            background: #C8CBD1;
                                        }
                                    }

                                    Text {
                                        x: 0px;
                                        y: 60px;
                                        width: parent.width;
                                        height: 24px;
                                        text: "Choose an image or video to enhance";
                                        color: Theme.text-primary;
                                        font-size: 17px;
                                        font-weight: 600;
                                        letter-spacing: -0.2px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        x: 0px;
                                        y: 92px;
                                        width: parent.width;
                                        height: 36px;
                                        text: "Upscale photos and video, or remove\nnoise — with local AI models.";
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    FlatButton {
                                        x: (parent.width - 140px) / 2;
                                        y: 144px;
                                        width: 140px;
                                        text: "Choose Media…";
                                        primary: true;
                                        active: root.controls-enabled;
                                        clicked => { root.choose-images(); }
                                    }

                                    Text {
                                        x: 0px;
                                        y: 188px;
                                        width: parent.width;
                                        height: 16px;
                                        text: "Runs entirely on this Mac — nothing is uploaded.";
                                        color: Theme.text-tertiary;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Floating glass chips name what each side of
                                // the compare divider shows.
                                Rectangle {
                                    x: 12px;
                                    y: 12px;
                                    width: min(240px, parent.width / 2 - 20px);
                                    height: 24px;
                                    border-radius: 6px;
                                    background: Theme.bg-overlay;
                                    border-width: 1px;
                                    border-color: #FFFFFF14;
                                    drop-shadow-blur: 16px;
                                    drop-shadow-color: #00000073;
                                    drop-shadow-offset-y: 4px;
                                    visible: root.image-ready;

                                    Text {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        text: root.result-ready && root.comparison-enabled ?
                                            root.result-label : root.source-label;
                                        color: #E7E9ED;
                                        font-size: 11px;
                                        font-weight: 500;
                                        letter-spacing: 0.2px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    x: parent.width - self.width - 12px;
                                    y: 12px;
                                    width: min(190px, parent.width / 2 - 20px);
                                    height: 24px;
                                    border-radius: 6px;
                                    background: Theme.bg-overlay;
                                    border-width: 1px;
                                    border-color: #FFFFFF14;
                                    drop-shadow-blur: 16px;
                                    drop-shadow-color: #00000073;
                                    drop-shadow-offset-y: 4px;
                                    visible: root.result-ready;

                                    Text {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        text: root.comparison-enabled ? root.source-label : root.result-label;
                                        color: #E7E9ED;
                                        font-size: 11px;
                                        font-weight: 500;
                                        letter-spacing: 0.2px;
                                        horizontal-alignment: right;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }

                                preview-touch := TouchArea {
                                    property <length> pan-start-x: 0px;
                                    property <length> pan-start-y: 0px;
                                    property <bool> dragging-divider: false;
                                    property <float> zoom-anchor-x: 0.5;
                                    property <float> zoom-anchor-y: 0.5;
                                    property <float> next-zoom: 1;
                                    property <length> next-width: 0px;
                                    property <length> next-height: 0px;
                                    property <length> next-max-pan-x: 0px;
                                    property <length> next-max-pan-y: 0px;
                                    enabled: root.image-ready;
                                    mouse-cursor: root.result-ready && root.comparison-enabled &&
                                        abs(self.mouse-x - (preview-content.x +
                                            preview-content.width * root.compare-position)) <= 24px ?
                                        col-resize : root.preview-zoom > 1 ? move : default;

                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down) {
                                            self.pan-start-x = root.preview-pan-x;
                                            self.pan-start-y = root.preview-pan-y;
                                            self.dragging-divider = root.result-ready &&
                                                root.comparison-enabled &&
                                                abs(self.mouse-x - (preview-content.x +
                                                    preview-content.width * root.compare-position)) <= 24px;
                                        }
                                        if (event.kind == PointerEventKind.up ||
                                            event.kind == PointerEventKind.cancel) {
                                            self.dragging-divider = false;
                                        }
                                    }

                                    moved => {
                                        if (self.dragging-divider) {
                                            root.compare-position = max(
                                                0.0,
                                                min(1.0, (self.mouse-x - preview-content.x) /
                                                    preview-content.width)
                                            );
                                        } else if (root.preview-zoom > 1) {
                                            root.preview-pan-x = max(
                                                -canvas.max-pan-x,
                                                min(canvas.max-pan-x,
                                                    self.pan-start-x + self.mouse-x - self.pressed-x)
                                            );
                                            root.preview-pan-y = max(
                                                -canvas.max-pan-y,
                                                min(canvas.max-pan-y,
                                                    self.pan-start-y + self.mouse-y - self.pressed-y)
                                            );
                                        }
                                    }

                                    double-clicked => {
                                        root.preview-zoom = 1;
                                        root.preview-pan-x = 0px;
                                        root.preview-pan-y = 0px;
                                    }

                                    scroll-event(event) => {
                                        self.zoom-anchor-x = max(0, min(1,
                                            (self.mouse-x - preview-content.x) /
                                                max(1px, preview-content.width)));
                                        self.zoom-anchor-y = max(0, min(1,
                                            (self.mouse-y - preview-content.y) /
                                                max(1px, preview-content.height)));
                                        self.next-zoom = event.delta-y < 0px ?
                                            min(8, root.preview-zoom * 1.12) :
                                            max(1, root.preview-zoom / 1.12);
                                        self.next-width = canvas.fit-width * self.next-zoom;
                                        self.next-height = canvas.fit-height * self.next-zoom;
                                        self.next-max-pan-x = max(0px,
                                            (self.next-width - canvas.width) / 2);
                                        self.next-max-pan-y = max(0px,
                                            (self.next-height - canvas.height) / 2);
                                        root.preview-zoom = self.next-zoom;
                                        root.preview-pan-x = max(
                                            -self.next-max-pan-x,
                                            min(self.next-max-pan-x,
                                                self.mouse-x - self.zoom-anchor-x * self.next-width -
                                                    (canvas.width - self.next-width) / 2)
                                        );
                                        root.preview-pan-y = max(
                                            -self.next-max-pan-y,
                                            min(self.next-max-pan-y,
                                                self.mouse-y - self.zoom-anchor-y * self.next-height -
                                                    (canvas.height - self.next-height) / 2)
                                        );
                                        if (self.next-zoom <= 1) {
                                            root.preview-pan-x = 0px;
                                            root.preview-pan-y = 0px;
                                        }
                                        return accept;
                                    }
                                }

                                // Floating zoom HUD. Declared after the pan
                                // TouchArea so its buttons win hit-testing; it
                                // courteously fades while the image is touched.
                                Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    y: parent.height - 46px + (root.image-ready ? 0px : 6px);
                                    width: root.result-ready ? 274px : 169px;
                                    height: 34px;
                                    border-radius: 8px;
                                    background: Theme.bg-overlay;
                                    border-width: 1px;
                                    border-color: #FFFFFF14;
                                    drop-shadow-blur: 20px;
                                    drop-shadow-color: #00000080;
                                    drop-shadow-offset-y: 4px;
                                    clip: true;
                                    visible: root.image-ready;
                                    opacity: !root.image-ready ? 0 :
                                        preview-touch.pressed ? 0.25 : 1;
                                    animate opacity { duration: 160ms; easing: cubic-bezier(0.2, 0.7, 0.2, 1); }
                                    animate y { duration: 180ms; easing: cubic-bezier(0.2, 0.7, 0.2, 1); }

                                    Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: 1px; background: #FFFFFF0F; }

                                    HorizontalLayout {
                                        x: 4px;
                                        y: 4px;
                                        height: 26px;
                                        spacing: 2px;

                                        HudButton {
                                            glyph: "−";
                                            label: "Zoom out";
                                            active: root.image-ready && root.preview-zoom > 1;
                                            clicked => {
                                                root.preview-zoom = max(1, root.preview-zoom / 1.25);
                                                if (root.preview-zoom <= 1) {
                                                    root.preview-pan-x = 0px;
                                                    root.preview-pan-y = 0px;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            width: 52px;
                                            background: transparent;
                                            Text {
                                                text: round(root.preview-zoom * 100) + "%";
                                                color: #E7E9ED;
                                                font-size: 11px;
                                                font-weight: 500;
                                                letter-spacing: 0.3px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        HudButton {
                                            glyph: "+";
                                            label: "Zoom in";
                                            active: root.image-ready && root.preview-zoom < 8;
                                            clicked => { root.preview-zoom = min(8, root.preview-zoom * 1.25); }
                                        }

                                        Rectangle {
                                            width: 9px;
                                            background: transparent;
                                            Rectangle { x: 4px; y: 5px; width: 1px; height: 16px; background: #FFFFFF14; }
                                        }

                                        HudButton {
                                            glyph: "Fit";
                                            label: "Fit to window";
                                            glyph-size: 11px;
                                            width: 40px;
                                            active: root.image-ready;
                                            clicked => {
                                                root.preview-zoom = 1;
                                                root.preview-pan-x = 0px;
                                                root.preview-pan-y = 0px;
                                            }
                                        }

                                        if root.result-ready: Rectangle {
                                            width: 9px;
                                            background: transparent;
                                            Rectangle { x: 4px; y: 5px; width: 1px; height: 16px; background: #FFFFFF14; }
                                        }

                                        if root.result-ready: Rectangle {
                                            width: 92px;
                                            height: 26px;
                                            border-radius: 6px;
                                            background: root.comparison-enabled ? #4E8CFF1F :
                                                compare-touch.has-hover ? #FFFFFF12 : transparent;
                                            animate background { duration: 120ms; easing: ease; }

                                            accessible-role: button;
                                            accessible-checkable: true;
                                            accessible-checked: root.comparison-enabled;
                                            accessible-label: "Compare";
                                            accessible-action-default => {
                                                root.comparison-enabled = !root.comparison-enabled;
                                            }

                                            Rectangle {
                                                x: 10px;
                                                y: (parent.height - 7px) / 2;
                                                width: 7px;
                                                height: 7px;
                                                border-radius: 3.5px;
                                                background: root.comparison-enabled ? Theme.accent : #575C64;
                                                animate background { duration: 120ms; easing: ease; }
                                            }

                                            Text {
                                                x: 22px;
                                                width: parent.width - 30px;
                                                text: "Compare";
                                                color: root.comparison-enabled ?
                                                    Theme.text-primary : Theme.text-secondary;
                                                font-size: 11px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }

                                            compare-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.comparison-enabled = !root.comparison-enabled;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Seam shadows on the stage's own edges (the darker plane).
                Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: Theme.sep-shadow; }
                Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: Theme.sep-shadow; }
            }

            // One editable inspector: goal first, one-click recipes second, and
            // a single disclosure for specialist configuration.
            if root.enhance-pane-visible: Rectangle {
                width: root.layout-mode == 0 ? 352px :
                    root.layout-mode == 1 ? root.width - 276px : root.width;
                horizontal-stretch: 0;
                background: Theme.bg-panel;

                ScrollView {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height - 88px;
                    viewport-width: self.width;

                    VerticalLayout {
                        x: (parent.width - min(320px, parent.width - 32px)) / 2;
                        y: 16px;
                        width: min(320px, parent.width - 32px);
                        spacing: 8px;

                        PanelHeading {
                            title: "Enhance";
                        }

                        SectionTitle { step: 1; title: "TASK"; }

                        HorizontalLayout {
                            height: 72px;
                            spacing: 8px;

                            TaskChoice {
                                title: "Upscale";
                                detail: "Increase resolution and recover detail";
                                selected: root.task-selected && root.task-index == 0;
                                active: root.model-selection-enabled;
                                clicked => { root.task-changed(0); }
                            }

                            TaskChoice {
                                title: "Denoise";
                                detail: "Remove photo noise at original size";
                                selected: root.task-selected && root.task-index == 1;
                                active: root.model-selection-enabled;
                                clicked => { root.task-changed(1); }
                            }
                        }

                        Rectangle {
                            height: 28px;
                            border-radius: 6px;
                            background: root.video-enabled && video-touch.has-hover ?
                                Theme.bg-row-hover : transparent;

                            accessible-role: button;
                            accessible-enabled: root.video-enabled && root.model-selection-enabled;
                            accessible-label: root.video-enabled ?
                                "Upscale Video · Labs" : "Video enhancement, coming soon";

                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: root.video-enabled ? "Upscale Video · Labs / Experimental" : "Video enhancement · Coming soon";
                                color: root.video-enabled ? Theme.accent : Theme.text-tertiary;
                                font-size: root.video-enabled ? 12px : 11px;
                                font-weight: root.video-enabled ? 500 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            video-touch := TouchArea {
                                enabled: root.video-enabled && root.model-selection-enabled;
                                mouse-cursor: pointer;
                                clicked => { root.task-changed(2); }
                            }
                        }

                        if root.task-selected || root.custom-recipes.length > 0: ThinSeparator { }

                        if root.task-selected || root.custom-recipes.length > 0: SectionTitle {
                            step: 2;
                            title: "RECIPES";
                        }

                        if root.task-selected: RecipeChoice {
                            title: "Quick Start";
                            detail: root.image-ready ?
                                "Fastest compatible setup · starts now" :
                                "Add an image to enable this setup";
                            primary: true;
                            active: root.model-selection-enabled && root.image-ready &&
                                root.task-index != 2;
                            clicked => { root.quick-setup(); }
                        }

                        if root.task-selected: RecipeChoice {
                            title: "Best Quality";
                            detail: root.image-ready ?
                                "Highest-fidelity setup · starts now" :
                                "Add an image to enable this setup";
                            active: root.model-selection-enabled && root.image-ready &&
                                root.task-index != 2;
                            clicked => { root.best-setup(); }
                        }

                        if root.task-selected: Text {
                            text: "Quick Start and Best Quality choose safe hardware settings. " +
                                "A missing model is verified before the job starts.";
                            color: Theme.text-tertiary;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        for recipe[index] in root.custom-recipes: CustomRecipeRow {
                            title: recipe.name;
                            detail: recipe.detail;
                            active: root.controls-enabled && root.model-selection-enabled;
                            clicked => { root.apply-recipe(index); }
                            removed => { root.delete-recipe(index); }
                        }

                        if root.task-selected && !root.recipe-editor-open: Rectangle {
                            height: 28px;
                            border-radius: 6px;
                            background: save-recipe-touch.has-hover ?
                                Theme.bg-row-hover : transparent;
                            animate background { duration: 120ms; easing: ease; }

                            accessible-role: button;
                            accessible-enabled: root.controls-enabled;
                            accessible-label: "Save current settings as recipe";

                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: "＋ Save Current Settings as Recipe";
                                color: save-recipe-touch.has-hover ?
                                    Theme.text-primary : Theme.text-secondary;
                                font-size: 11px;
                                font-weight: 500;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            save-recipe-touch := TouchArea {
                                enabled: root.controls-enabled;
                                mouse-cursor: pointer;
                                clicked => { root.recipe-editor-open = true; }
                            }
                        }

                        if root.recipe-editor-open: HorizontalLayout {
                            height: 30px;
                            spacing: 6px;

                            Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.bg-recess;
                                border-width: 1px;
                                border-color: recipe-name-input.has-focus ?
                                    Theme.focus : Theme.border-recess;
                                border-radius: 6px;
                                clip: true;

                                recipe-name-input := TextInput {
                                    x: 10px;
                                    y: 7px;
                                    width: parent.width - 20px;
                                    height: 16px;
                                    text <=> root.recipe-name-draft;
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    single-line: true;
                                    accepted => { root.save-recipe(root.recipe-name-draft); }
                                }

                                Text {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    text: "Recipe name";
                                    color: Theme.text-tertiary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    visible: root.recipe-name-draft == "";
                                }
                            }

                            FlatButton {
                                text: "Save";
                                compact: true;
                                primary: true;
                                width: 58px;
                                height: 30px;
                                active: root.controls-enabled;
                                clicked => { root.save-recipe(root.recipe-name-draft); }
                            }

                            FlatButton {
                                text: "Cancel";
                                compact: true;
                                width: 64px;
                                height: 30px;
                                clicked => {
                                    root.recipe-editor-open = false;
                                    root.recipe-name-draft = "";
                                }
                            }
                        }

                        ThinSeparator { }

                        DisclosureRow {
                            text: "Advanced settings";
                            summary: "Model, output, hardware";
                            open: root.advanced-open;
                            active: root.controls-enabled;
                            toggled => { root.advanced-open = !root.advanced-open; }
                        }

                        if root.advanced-open: VerticalLayout {
                            spacing: 8px;

                            ThinSeparator { }

                            SectionTitle { title: "MODEL & SIZE"; }
                            VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    height: 18px;
                                    spacing: 6px;
                                    FieldLabel { label: "Restoration model"; }
                                    InfoDot {
                                        y: 1px;
                                        tip: root.model-info-text;
                                        tip-height: 208px;
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                                DesktopComboBox {
                                    model: root.model-options;
                                    enabled: root.model-selection-enabled && root.task-selected;
                                    current-index <=> root.model-index;
                                    selected(value) => { root.model-changed(root.model-index); }
                                }
                            }

                            Text {
                                text: root.model-description;
                                color: Theme.text-tertiary;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            if root.model-action-visible: FlatButton {
                                text: root.model-action-text;
                                compact: true;
                                active: root.controls-enabled && root.model-action-enabled;
                                clicked => { root.model-action(); }
                            }

                            if root.download-visible: ProgressTrack {
                                value: root.download-progress;
                            }

                            Text {
                                text: root.model-status;
                                color: Theme.text-tertiary;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            if root.task-selected && root.task-index != 1: VerticalLayout {
                                spacing: 4px;
                                FieldLabel { label: "Output scale"; }
                                SegmentedHousing {
                                    HorizontalLayout {
                                        x: 3px;
                                        y: 3px;
                                        width: parent.width - 6px;
                                        height: 24px;
                                        spacing: 2px;

                                        for option[index] in root.scale-options: SegmentedButton {
                                            text: option;
                                            selected: root.scale-index == index;
                                            active: root.controls-enabled;
                                            clicked => {
                                                root.scale-index = index;
                                                root.scale-changed(index);
                                            }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: root.output-dimensions;
                                color: Theme.text-secondary;
                                font-size: 11px;
                                height: 20px;
                                visible: root.task-selected;
                                vertical-alignment: center;
                            }

                            ThinSeparator { }
                            SectionTitle { title: "OUTPUT"; }
                            VerticalLayout {
                                spacing: 4px;
                                FieldLabel { label: "Format"; }
                                DesktopComboBox {
                                    model: root.format-options;
                                    enabled: root.controls-enabled;
                                    current-index <=> root.format-index;
                                    selected(value) => { root.format-changed(root.format-index); }
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                FieldLabel { label: "Save to"; }
                                HorizontalLayout {
                                height: 30px;
                                spacing: 6px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: Theme.bg-recess;
                                    border-width: 1px;
                                    border-color: Theme.border-recess;
                                    border-radius: 6px;
                                    clip: true;

                                    Rectangle { x: 1px; y: parent.height - 2px; width: parent.width - 2px; height: 1px; background: #FFFFFF08; }

                                    Text {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        text: root.output-directory;
                                        color: Theme.text-secondary;
                                        font-size: 11px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }

                                FlatButton {
                                    text: "Choose…";
                                    compact: true;
                                    width: 78px;
                                    height: 30px;
                                    active: root.controls-enabled;
                                    clicked => { root.choose-output-directory(); }
                                }
                            }
                            }

                            CheckControl {
                                text: "Preserve safe metadata";
                                checked: root.preserve-metadata;
                                active: root.controls-enabled;
                                toggled(value) => {
                                    root.preserve-metadata = value;
                                    root.preserve-metadata-changed(value);
                                }
                            }

                            if root.format-index == 1: VerticalLayout {
                                spacing: 4px;
                                FieldLabel { label: "JPEG quality"; }

                                Rectangle {
                                    height: 32px;
                                    background: transparent;

                                    ProgressTrack {
                                        x: 0px;
                                        y: 14px;
                                        width: parent.width - 48px;
                                        value: (root.jpeg-quality - 70) / 30;
                                    }

                                    Rectangle {
                                        x: (parent.width - 58px) * (root.jpeg-quality - 70) / 30;
                                        y: 9px;
                                        width: 14px;
                                        height: 14px;
                                        border-radius: 7px;
                                        background: #EBEDF1;
                                        border-width: 1px;
                                        border-color: #00000066;
                                        drop-shadow-blur: 6px;
                                        drop-shadow-color: #00000080;
                                        drop-shadow-offset-y: 1px;
                                    }

                                    Text {
                                        x: parent.width - 42px;
                                        width: 42px;
                                        text: root.jpeg-quality;
                                        color: Theme.text-secondary;
                                        font-size: 11px;
                                        font-weight: 500;
                                        letter-spacing: 0.3px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }

                                    quality-touch := TouchArea {
                                        width: parent.width - 44px;
                                        enabled: root.controls-enabled;
                                        mouse-cursor: pointer;
                                        moved => {
                                            root.jpeg-quality = max(70, min(100,
                                                round(70 + self.mouse-x / self.width * 30)));
                                            root.jpeg-quality-changed(root.jpeg-quality);
                                        }
                                        clicked => {
                                            root.jpeg-quality = max(70, min(100,
                                                round(70 + self.mouse-x / self.width * 30)));
                                            root.jpeg-quality-changed(root.jpeg-quality);
                                        }
                                    }
                                }
                            }

                            ThinSeparator { }
                            SectionTitle { title: "HARDWARE & MEMORY"; }
                            VerticalLayout {
                                spacing: 4px;
                                FieldLabel { label: "Compute device"; }
                                DesktopComboBox {
                                    model: root.device-options;
                                    enabled: root.controls-enabled;
                                    current-index <=> root.device-index;
                                    selected(value) => { root.device-changed(root.device-index); }
                                }
                            }

                            HorizontalLayout {
                                height: 52px;
                                spacing: 8px;

                                VerticalLayout {
                                    spacing: 4px;
                                    FieldLabel { label: "Tile size"; }
                                    DesktopComboBox {
                                        model: root.tile-options;
                                        enabled: root.controls-enabled;
                                        current-index <=> root.tile-index;
                                        selected(value) => { root.tile-changed(root.tile-index); }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    FieldLabel { label: "Overlap"; }
                                    DesktopComboBox {
                                        model: root.halo-options;
                                        enabled: root.controls-enabled;
                                        current-index <=> root.halo-index;
                                        selected(value) => { root.halo-changed(root.halo-index); }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                FieldLabel { label: "Precision"; }
                                DesktopComboBox {
                                    model: root.precision-options;
                                    enabled: root.controls-enabled;
                                    current-index <=> root.precision-index;
                                    selected(value) => { root.precision-changed(root.precision-index); }
                                }
                            }

                            HorizontalLayout {
                                height: 30px;
                                spacing: 6px;

                                CheckControl {
                                    horizontal-stretch: 1;
                                    text: "Safe memory mode";
                                    checked: root.safe-memory;
                                    active: root.controls-enabled && root.safe-memory-enabled;
                                    toggled(value) => {
                                        root.safe-memory = value;
                                        root.safe-memory-changed(value);
                                    }
                                }

                                InfoDot {
                                    y: 7px;
                                    tip: "Processes the image in smaller, disk-backed steps so a "
                                        + "large job cannot exhaust memory. Slower, but it "
                                        + "prevents out-of-memory failures. Off by default; it "
                                        + "turns itself on when free memory is very low.";
                                    tip-height: 118px;
                                }
                            }

                            // Video-only: temporal de-flicker toggle.
                            CheckControl {
                                text: "De-flicker (temporal median)";
                                checked: root.deflicker;
                                active: root.controls-enabled && root.task-index == 2;
                                toggled(value) => {
                                    root.deflicker = value;
                                }
                            }

                            ValueLine { label: "Pressure"; value: root.pressure-text; }
                            ValueLine { label: "Projected"; value: root.memory-usage-text; }
                            ProgressTrack {
                                value: root.memory-usage-ratio;
                                fill-color: root.memory-usage-ratio > 0.85 ? Theme.gauge-crit :
                                    root.memory-usage-ratio > 0.65 ? Theme.gauge-warn : Theme.gauge-ok;
                            }

                            Text {
                                text: root.hardware-summary;
                                color: Theme.text-tertiary;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            FlatButton {
                                text: "Refresh Hardware";
                                compact: true;
                                active: !root.can-cancel;
                                clicked => { root.refresh-hardware(); }
                            }

                            ThinSeparator { }
                            SectionTitle { title: "ABOUT & SUPPORT"; }

                            Text {
                                text: "LocalSR " + root.app-version + " · Alpha software";
                                color: Theme.text-secondary;
                                font-size: 11px;
                            }

                            FlatButton {
                                text: "Copy Diagnostics";
                                compact: true;
                                clicked => { root.copy-diagnostics(); }
                            }

                            AboutSlint {
                                height: 86px;
                            }
                        }

                        ThinSeparator { }
                        SectionTitle { title: "RUN SUMMARY"; }

                        // A recessed receipt card: the six facts of the job.
                        Rectangle {
                            border-radius: 8px;
                            background: Theme.bg-recess;
                            border-width: 1px;
                            border-color: #FFFFFF0A;

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 0px;

                                ValueLine { label: "Input"; value: root.selected-name == "" ? "—" : root.selected-name; }
                                Rectangle { height: 1px; background: #FFFFFF08; }
                                ValueLine { label: "Task"; value: root.task-summary; placeholder: !root.task-selected; }
                                Rectangle { height: 1px; background: #FFFFFF08; }
                                ValueLine { label: "Output"; value: root.output-dimensions; placeholder: !root.task-selected; }
                                Rectangle { height: 1px; background: #FFFFFF08; }
                                ValueLine { label: "Time"; value: root.estimate-time; }
                                Rectangle { height: 1px; background: #FFFFFF08; }
                                ValueLine { label: "File size"; value: root.estimate-output; }
                                Rectangle { height: 1px; background: #FFFFFF08; }
                                ValueLine { label: "Save to"; value: root.output-summary; }
                            }
                        }

                        Text {
                            text: root.estimate-detail;
                            color: Theme.text-tertiary;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        if root.estimate-warning != "": Rectangle {
                            border-radius: 8px;
                            background: Theme.warn-bg;
                            border-width: 1px;
                            border-color: Theme.warn-border;

                            Rectangle {
                                x: 0px;
                                y: 6px;
                                width: 3px;
                                height: parent.height - 12px;
                                border-radius: 1.5px;
                                background: Theme.warn;
                            }

                            VerticalLayout {
                                padding-top: 8px;
                                padding-bottom: 8px;
                                padding-left: 14px;
                                padding-right: 12px;

                                Text {
                                    text: root.estimate-warning;
                                    color: Theme.warn-text;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle { height: 18px; background: transparent; }
                    }
                }

                // Content dissolves into the panel before it meets the pinned
                // action dock, instead of slicing mid-line at the clip edge.
                Rectangle {
                    x: 0px;
                    y: parent.height - 102px;
                    width: parent.width;
                    height: 14px;
                    background: @linear-gradient(180deg, #1B1D2200 0%, #1B1D22 100%);
                }

                // The only persistent primary action. Automatic recipes above
                // are explicitly labelled as immediate commands.
                Rectangle {
                    x: 0px;
                    y: parent.height - 88px;
                    width: parent.width;
                    height: 88px;
                    background: Theme.bg-chrome;
                    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.sep-shadow; }
                    Rectangle { x: 0px; y: 1px; width: parent.width; height: 1px; background: Theme.sep-light; }

                    FlatButton {
                        x: (parent.width - min(320px, parent.width - 32px)) / 2;
                        y: 12px;
                        width: min(320px, parent.width - 32px);
                        height: 40px;
                        border-radius: 8px;
                        text: root.can-cancel ? "Cancel Current Job" : root.action-text;
                        primary: !root.can-cancel;
                        destructive: root.can-cancel;
                        active: root.can-cancel || root.can-start;
                        clicked => {
                            if (root.can-cancel) {
                                root.cancel-job();
                            } else {
                                root.start-job();
                            }
                        }
                    }

                    Text {
                        x: (parent.width - min(320px, parent.width - 32px)) / 2;
                        y: 58px;
                        width: min(320px, parent.width - 32px);
                        height: 18px;
                        text: !root.task-selected ? "Choose Upscale or Denoise to continue." :
                            !root.image-ready ? "Add an image to continue." :
                            root.can-cancel ? "Cancellation is safe after the active tile." :
                            root.can-start ? "Uses the settings shown above." : root.status-detail;
                        color: Theme.text-tertiary;
                        font-size: 11px;
                        horizontal-alignment: center;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                // Seam toward the darker preview stage: catch-light on this,
                // the lighter plane.
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 1px;
                    height: parent.height;
                    background: root.layout-mode == 0 ? Theme.sep-light : Theme.sep-inset;
                    visible: root.layout-mode != 2;
                }
            }
        }

        // Status is persistent but secondary; job actions stay with Enhance.
        Rectangle {
            height: 44px;
            background: Theme.bg-chrome;
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.sep-shadow; }
            Rectangle { x: 0px; y: 1px; width: parent.width; height: 1px; background: Theme.sep-light; }

            // Progress filament: during a job the chassis rim conducts power.
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * root.progress;
                height: 2px;
                background: @linear-gradient(90deg, #4E8CFF 0%, #6A9EFE 100%);
                drop-shadow-blur: 6px;
                drop-shadow-color: #4E8CFF66;
                visible: root.can-cancel || root.progress > 0;
                animate width { duration: 140ms; easing: linear; }
            }

            Text {
                x: 16px;
                y: 6px;
                width: 210px;
                height: 16px;
                text: root.batch-progress == "" ? root.status-title :
                    root.batch-progress + " · " + root.status-title;
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
            }

            Text {
                x: 16px;
                y: 23px;
                width: parent.width - 400px;
                height: 16px;
                text: root.status-detail;
                color: Theme.text-tertiary;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }

            HorizontalLayout {
                x: parent.width - 360px;
                y: 9px;
                width: 344px;
                height: 26px;
                spacing: 7px;

                FlatButton {
                    text: "Open Result";
                    compact: true;
                    chip: true;
                    height: 26px;
                    active: root.can-open-result;
                    visible: root.can-open-result && !root.can-cancel;
                    clicked => { root.open-result(); }
                }

                FlatButton {
                    text: "Show in Folder";
                    compact: true;
                    chip: true;
                    height: 26px;
                    active: root.can-open-result;
                    visible: root.can-open-result && !root.can-cancel;
                    clicked => { root.reveal-result(); }
                }

                FlatButton {
                    text: "Cancel";
                    compact: true;
                    chip: true;
                    height: 26px;
                    destructive: root.can-cancel;
                    active: root.can-cancel;
                    visible: root.can-cancel && !root.enhance-pane-visible;
                    clicked => { root.cancel-job(); }
                }
            }
        }
    }
}
