# /etc/caddy/Caddyfile on the relay server. REVIEW TEMPLATE ONLY.
# The relay stores no files; it forwards read-only requests to the Mac mini.
{$LOCALSR_PUBLIC_HOST:downloads.example.org} {
    @allowed {
        method GET HEAD
        path /releases/* /updates/* /health.txt
    }
    handle @allowed {
        reverse_proxy 10.77.0.2:8788 {
            # Large files stream through without buffering.
            flush_interval -1
            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }
    handle {
        respond 404
    }
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
}
