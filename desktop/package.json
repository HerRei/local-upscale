{
  "name": "localsr-desktop",
  "private": true,
  "version": "0.6.3-beta",
  "type": "module",
  "scripts": {
    "dev": "npm run build:frontend && vite preview --host localhost --port 1420 --strictPort",
    "dev:web": "vite",
    "build:frontend": "vite build",
    "build": "svelte-check --tsconfig ./tsconfig.json && npm run build:frontend",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "knip": "knip --no-progress",
    "test": "vitest run --testTimeout=20000",
    "tauri": "tauri",
    "format": "prettier --write \"src/**/*.{svelte,ts,css}\"",
    "format:check": "prettier --check \"src/**/*.{svelte,ts,css}\"",
    "e2e": "playwright test",
    "e2e:update": "playwright test --grep @visual --update-snapshots"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "svelte": "5.59.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.6",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "fast-check": "^4.10.3",
    "jsdom": "^30.1.3",
    "knip": "6.45.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
