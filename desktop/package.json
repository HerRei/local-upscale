{
  "name": "localsr-desktop",
  "private": true,
  "version": "0.3.2-beta",
  "type": "module",
  "scripts": {
    "dev": "npm run build:frontend && vite preview --host localhost --port 1420 --strictPort",
    "dev:web": "vite",
    "build:frontend": "vite build",
    "build": "svelte-check --tsconfig ./tsconfig.json && npm run build:frontend",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "knip": "knip --no-progress",
    "test": "vitest run --testTimeout=20000",
    "tauri": "tauri",
    "format": "prettier --write \"src/**/*.{svelte,ts,css}\"",
    "format:check": "prettier --check \"src/**/*.{svelte,ts,css}\""
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "knip": "6.43.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.3"
  }
}
